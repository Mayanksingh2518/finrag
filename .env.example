# SEC requires a descriptive User-Agent with a real contact email
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="FinRAG portfolio project your.email@example.com"

# Free-tier LLM providers (needed from Phase 5; embeddings/reranker run locally)
# Gemini: https://aistudio.google.com/apikey   Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional offline fallback (install from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
